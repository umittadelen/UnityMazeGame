@@ -0,0 +1,20 @@
+using UnityEngine;
+
+// Per-machine settings (never synced in multiplayer).
+public static class LocalSettings
+{
+    public const int DefaultChunkSize = 5;
+    public const int DefaultRenderDistance = 1;
+
+    public static int ChunkSize
+    {
+        get => Mathf.Max(1, PlayerPrefs.GetInt("ChunkSize", DefaultChunkSize));
+        set { PlayerPrefs.SetInt("ChunkSize", Mathf.Max(1, value)); PlayerPrefs.Save(); }
+    }
+
+    public static int RenderDistance
+    {
+        get => Mathf.Max(1, PlayerPrefs.GetInt("RenderDistance", DefaultRenderDistance));
+        set { PlayerPrefs.SetInt("RenderDistance", Mathf.Max(1, value)); PlayerPrefs.Save(); }
+    }
+}
diff -ruN --strip-trailing-cr a/Core/MatchConfig.cs b/Core/MatchConfig.cs
--- a/Core/MatchConfig.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/Core/MatchConfig.cs	2026-11-10 16:23:49.379171057 +0100
@@ -0,0 +1,63 @@
+using System;
+using UnityEngine;
+
+// Everything that must match on every machine to produce the same maze.
+[Serializable]
+public struct MatchConfig
+{
+    public int Width;
+    public int Height;
+    public int Depth;
+    public int Seed;        // always resolved, never -1
+    public bool RandomSeed; // Play Again rerolls when true
+
+    public static MatchConfig Create(int width, int height, int depth, int seed)
+    {
+        width = Mathf.Max(1, width);
+        height = Mathf.Max(1, height);
+        depth = Mathf.Max(1, depth);
+        if (width == 1 && height == 1) width = 2;
+        if (depth == 1 && (width == 1 || height == 1)) depth = 2;
+
+        bool random = seed == -1;
+        return new MatchConfig
+        {
+            Width = width, Height = height, Depth = depth,
+            Seed = random ? NewSeed() : seed,
+            RandomSeed = random
+        };
+    }
+
+    public static MatchConfig FromInput(string width, string height, string depth, string seedText)
+    {
+        int.TryParse(width, out int w);
+        int.TryParse(height, out int h);
+        int.TryParse(depth, out int d);
+        return Create(w, h, d, ParseSeed(seedText));
+    }
+
+    public MatchConfig Rerolled()
+    {
+        var c = this;
+        if (c.RandomSeed) c.Seed = NewSeed();
+        return c;
+    }
+
+    // Empty -> random, number -> number, text -> hash that is the same on every machine.
+    private static int ParseSeed(string text)
+    {
+        if (string.IsNullOrWhiteSpace(text)) return -1;
+        text = text.Trim();
+        if (int.TryParse(text, out int n)) return n;
+
+        unchecked
+        {
+            uint h = 2166136261;
+            foreach (char ch in text) { h ^= ch; h *= 16777619; }
+            return (int)(h & 0x7FFFFFFF);
+        }
+    }
+
+    // Not UnityEngine.Random: maze generation reseeds it, so it would repeat.
+    public static int NewSeed() => (int)((DateTime.UtcNow.Ticks ^ Guid.NewGuid().GetHashCode()) & 0x7FFFFFFF);
+}
diff -ruN --strip-trailing-cr a/Core/SceneLoader.cs b/Core/SceneLoader.cs
--- a/Core/SceneLoader.cs	1970-01-01 01:00:00.000000000 +0100
+++ b/Core/SceneLoader.cs	2026-11-10 16:23:49.378920781 +0100
@@ -0,0 +1,84 @@
+using System.Collections;
+using UnityEngine;
+using UnityEngine.SceneManagement;
+using UnityEngine.UI;
+
+// Creates itself on startup. Fade to black -> load -> fade back in.
+public class SceneLoader : MonoBehaviour
+{
+    private const float FadeOutTime = 0.35f;
+    private const float FadeInTime = 0.6f;
+
+    public static bool IsLoading { get; private set; }
+
+    private static SceneLoader _instance;
+    private CanvasGroup _group;
+
+    [RuntimeInitializeOnLoadMethod(RuntimeInitializeLoadType.BeforeSceneLoad)]
+    private static void Create()
+    {
+        IsLoading = false;
+        var go = new GameObject("[SceneLoader]");
+        DontDestroyOnLoad(go);
+        _instance = go.AddComponent<SceneLoader>();
+        _instance.BuildOverlay();
+    }
+
+    public static void Load(string sceneName)
+    {
+        if (IsLoading) return;
+        _instance.StartCoroutine(_instance.LoadRoutine(sceneName));
+    }
+
+    private IEnumerator LoadRoutine(string sceneName)
+    {
+        IsLoading = true;
+        _group.blocksRaycasts = true;
+
+        yield return Fade(1f, FadeOutTime);
+        Time.timeScale = 1f;
+        yield return SceneManager.LoadSceneAsync(sceneName);
+        yield return null; // maze is built in Start, keep that frame hidden
+        yield return Fade(0f, FadeInTime);
+
+        _group.blocksRaycasts = false;
+        IsLoading = false;
+    }
+
+    private IEnumerator Fade(float to, float duration)
+    {
+        float from = _group.alpha;
+        for (float t = 0f; t < duration; t += Time.unscaledDeltaTime)
+        {
+            SetAlpha(Mathf.Lerp(from, to, Mathf.SmoothStep(0f, 1f, t / duration)));
+            yield return null;
+        }
+        SetAlpha(to);
+    }
+
+    private void SetAlpha(float a)
+    {
+        _group.alpha = a;
+        AudioListener.volume = 1f - a;
+    }
+
+    private void BuildOverlay()
+    {
+        var canvas = gameObject.AddComponent<Canvas>();
+        canvas.renderMode = RenderMode.ScreenSpaceOverlay;
+        canvas.sortingOrder = short.MaxValue;
+        gameObject.AddComponent<GraphicRaycaster>();
+
+        _group = gameObject.AddComponent<CanvasGroup>();
+        _group.alpha = 0f;
+        _group.blocksRaycasts = false;
+
+        var fade = new GameObject("Fade", typeof(RectTransform), typeof(Image));
+        fade.transform.SetParent(transform, false);
+        var rt = (RectTransform)fade.transform;
+        rt.anchorMin = Vector2.zero;
+        rt.anchorMax = Vector2.one;
+        rt.offsetMin = rt.offsetMax = Vector2.zero;
+        fade.GetComponent<Image>().color = Color.black;
+    }
+}
